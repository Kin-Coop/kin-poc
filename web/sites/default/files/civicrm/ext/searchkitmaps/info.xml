<?xml version="1.0"?>
<extension key="searchkitmaps" type="module">
  <file>searchkitmaps</file>
  <name>SearchKit Maps Display</name>
  <description>Maps display for SearchKit using OpenStreetMap</description>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>MJW</name>
      <email>info@mjwconsult.co.uk</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Main Extension Page">https://lab.civicrm.org/extensions/searchkitmaps</url>
    <url desc="Support">https://mjw.pt/support/searchkitmaps</url>
    <url desc="Documentation">https://docs.civicrm.org/searchkitmaps/en/latest/</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
    <url desc="Release Notes">https://docs.civicrm.org/searchkitmaps/en/latest/releasenotes/</url>
  </urls>
  <releaseDate>2026-09-22</releaseDate>
  <version>1.5.2</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.16</ver>
  </compatibility>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Searchkitmaps</namespace>
    <format>25.10.2</format>
    <angularModule>crmSearchkitmaps</angularModule>
  </civix>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>ang-php@1.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
</extension>
